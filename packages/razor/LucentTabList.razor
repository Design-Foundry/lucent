@*
    LucentTabList — emits the `.lucent-tab-list` contract (styles/components/tab-list.css).

    The glass track for LucentTab pills. Drives each child tab's scale and active state, and
    owns selection: two-way bind the active value with @bind-ActiveTab. Arrow/Home/End move
    selection. Requires an interactive render mode. Children register via a cascaded reference.
*@

<CascadingValue Value="this" IsFixed="true">
    <div class="@HostClass" role="tablist" tabindex="0" @onkeydown="OnKeyDown" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>Size applied to all child tabs.</summary>
    [Parameter] public TabScale Scale { get; set; } = TabScale.Md;

    /// <summary>Active tab value (two-way bindable with @bind-ActiveTab).</summary>
    [Parameter] public string ActiveTab { get; set; } = "";
    [Parameter] public EventCallback<string> ActiveTabChanged { get; set; }

    /// <summary>The LucentTab children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly List<LucentTab> _tabs = [];

    internal TabScale CurrentScale => Scale;
    internal string Current => ActiveTab;

    internal void Register(LucentTab tab)
    {
        if (!_tabs.Contains(tab)) _tabs.Add(tab);
    }

    internal void Unregister(LucentTab tab) => _tabs.Remove(tab);

    internal async Task SelectAsync(string value)
    {
        if (value == ActiveTab) return;
        ActiveTab = value;
        await ActiveTabChanged.InvokeAsync(value);
        foreach (var t in _tabs) t.Refresh();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var enabled = _tabs.Where(t => !t.Disabled).ToList();
        if (enabled.Count == 0) return;

        var cur = enabled.FindIndex(t => t.Value == ActiveTab);
        var next = cur;
        switch (e.Key)
        {
            case "ArrowRight": next = (cur + 1) % enabled.Count; break;
            case "ArrowLeft": next = (cur - 1 + enabled.Count) % enabled.Count; break;
            case "Home": next = 0; break;
            case "End": next = enabled.Count - 1; break;
            default: return;
        }
        await SelectAsync(enabled[next].Value);
    }

    private string HostClass =>
        "lucent-tab-list" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
