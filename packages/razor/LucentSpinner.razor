@*
    LucentSpinner — emits the `.lucent-spinner` contract (styles/components/spinner.css).

    A rotating 270° ring for indeterminate waits. The standalone form is accent-coloured;
    the same class inside a button/icon-button inherits the button's text colour.
*@

<span class="@HostClass"
      role="status"
      aria-label="@AccessibleLabel"
      @attributes="AdditionalAttributes"></span>

@code {
    /// <summary>Ring size.</summary>
    [Parameter] public SpinnerSize Size { get; set; } = SpinnerSize.Md;

    /// <summary>Accessible name announced to assistive tech. Defaults to "Loading".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host span.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string AccessibleLabel => string.IsNullOrWhiteSpace(Label) ? "Loading" : Label;

    private string HostClass =>
        $"lucent-spinner lucent-spinner--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
