@*
    LucentList — emits the `.lucent-list` contract (styles/components/list.css).
    A glass container that stacks LucentListItem rows. Content projects in.
*@

<div class="@HostClass" role="list" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>List rows.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        "lucent-list" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
