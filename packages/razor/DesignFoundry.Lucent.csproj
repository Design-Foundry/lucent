<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Packaging — name reserved on NuGet; do NOT publish until v1.0.0. -->
  <PropertyGroup>
    <PackageId>DesignFoundry.Lucent</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Design Foundry</Authors>
    <Description>Lucent design system — Razor (Blazor) component library.</Description>
    <RepositoryUrl>https://github.com/Design-Foundry/lucent</RepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Ship the shared styles/ base as static web assets. The canonical source is the
       repo-root styles/ (single source); mirror it into wwwroot before static-web-asset
       resolution so it reaches consumers as _content/DesignFoundry.Lucent/<path>.
       wwwroot/ is a build artifact (gitignored), not a second source. -->
  <ItemGroup>
    <LucentStyleSource Include="$(MSBuildProjectDirectory)\..\..\styles\**\*.css" />
  </ItemGroup>

  <Target Name="SyncLucentStyles" BeforeTargets="ResolveProjectStaticWebAssets;BeforeBuild">
    <Copy SourceFiles="@(LucentStyleSource)"
          DestinationFiles="@(LucentStyleSource->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
