@implements IDisposable
@*
    LucentTab — emits the `.lucent-tab` contract (styles/components/tab.css).

    One tab inside a LucentTabList (which drives its Scale + active state and owns selection).
    Usable standalone via the Scale/Active parameters. Rendered as a real <button> (role=tab).
*@

<button class="@HostClass"
        type="button"
        role="tab"
        aria-selected="@(IsActive ? "true" : "false")"
        tabindex="@(IsActive ? "0" : "-1")"
        disabled="@Disabled"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <LucentIcon Name="@Icon" Size="@(EffectiveScale == TabScale.Lg ? IconSize.Lg : IconSize.Md)" />
    }
    <span class="lucent-tab__label">
        @if (ChildContent is not null) { @ChildContent }
        else { @Label }
    </span>
</button>

@code {
    [CascadingParameter] private LucentTabList? Parent { get; set; }

    /// <summary>Identity used for selection (matched against the list's ActiveTab).</summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>Tab label shorthand — overridden by ChildContent.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Leading icon.</summary>
    [Parameter] public string? Icon { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Size when used without a parent list.</summary>
    [Parameter] public TabScale Scale { get; set; } = TabScale.Md;

    /// <summary>Active state when used without a parent list.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Tab content — overrides Label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host button.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private TabScale EffectiveScale => Parent?.CurrentScale ?? Scale;
    private bool IsActive => Parent is not null ? Parent.Current == Value : Active;

    protected override void OnInitialized() => Parent?.Register(this);

    public void Dispose() => Parent?.Unregister(this);

    internal void Refresh() => StateHasChanged();

    private Task OnClick() =>
        Parent is not null && !Disabled ? Parent.SelectAsync(Value) : Task.CompletedTask;

    private string HostClass =>
        $"lucent-tab lucent-tab--{EffectiveScale.ToToken()}"
        + (IsActive ? " lucent-tab--active" : "")
        + (Disabled ? " lucent-tab--disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
