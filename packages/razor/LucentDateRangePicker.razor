@*
    LucentDateRangePicker — emits the `.lucent-date-picker` contract (styles/components/date-picker.css).

    A field that opens the Calendar (range mode) in a popover to pick a start–end date pair. Two-way
    bind the chosen range with @bind-Value. The popover renders inline under the field (anchored by
    CSS); requires an interactive render mode (the suite's console runs Blazor Server interactivity).
*@

<div class="@HostClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lucent-date-picker__label">@Label</span>
    }

    <div class="lucent-date-picker__field">
        <button type="button"
                class="lucent-date-picker__trigger@(_open ? " lucent-date-picker__trigger--focus" : "")"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <LucentIcon Class="lucent-date-picker__icon" Name="date_range" Size="IconSize.Sm" />
            <span class="lucent-date-picker__value@(EffStart.HasValue ? "" : " is-placeholder")">@DisplayText</span>
            <LucentIcon Class="lucent-date-picker__caret" Name="arrow_drop_down" Size="IconSize.Sm" />
        </button>

        @if (_open)
        {
            <div class="lucent-date-picker__popover">
                <LucentCalendar Mode="CalendarMode.Range" Month="Month" RangeStart="_start" RangeEnd="_end" Min="Min" Max="Max" ValueChanged="Choose" />
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Selected range (two-way bindable with @bind-Value).</summary>
    [Parameter] public DateRange? Value { get; set; }
    [Parameter] public EventCallback<DateRange?> ValueChanged { get; set; }

    /// <summary>Field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown when no range is selected.</summary>
    [Parameter] public string Placeholder { get; set; } = "Select dates";

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Selectable bounds; days outside are disabled in the Calendar.</summary>
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    private bool _open;
    // Working selection while the popover is open (committed to Value once both ends are set).
    private DateTime? _start;
    private DateTime? _end;

    // Show the working range while open, the committed range when closed.
    private DateTime? EffStart => _open ? _start : Value?.Start;
    private DateTime? EffEnd => _open ? _end : Value?.End;
    private DateTime Month => (_open ? _start : Value?.Start) ?? DateTime.Today;
    private string DisplayText => EffStart is { } s ? FmtRange(s, EffEnd) : Placeholder;

    private string HostClass =>
        $"lucent-date-picker lucent-date-picker--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private void Toggle()
    {
        if (_open) { _open = false; return; }
        _start = Value?.Start;
        _end = Value?.End;
        _open = true;
    }

    private async Task Choose(DateTime date)
    {
        if (!_start.HasValue || _end.HasValue) { _start = date; _end = null; }       // begin a fresh range
        else if (date < _start.Value) { _end = _start; _start = date; }              // normalize start ≤ end
        else { _end = date; }

        if (_start.HasValue && _end.HasValue)
        {
            Value = new DateRange(_start.Value, _end.Value);
            await ValueChanged.InvokeAsync(Value);
            _open = false;
        }
    }

    private static string FmtRange(DateTime s, DateTime? e)
    {
        if (e is not { } end) return s.ToString("MMM d, yyyy");
        if (s.Year == end.Year && s.Month == end.Month) return $"{s:MMM d} – {end.Day}, {end.Year}";
        return $"{(s.Year == end.Year ? s.ToString("MMM d") : s.ToString("MMM d, yyyy"))} – {end:MMM d, yyyy}";
    }
}
