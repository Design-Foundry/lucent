@*
    LucentBadge — emits the `.lucent-badge` contract (styles/components/badge.css).

    A small status indicator: an unread Count, a short Label ("AI", "NEW"), or a bare
    presence Dot. Solid-filled on the accent/status axis — distinct from LucentStatusTag
    (a subtle record-state pill) and action Tone (CONVENTIONS §6).
*@

<span class="@HostClass" aria-hidden="@DotAriaHidden" @attributes="AdditionalAttributes">@if (Kind != BadgeKind.Dot)
    {
        @if (ChildContent is not null) { @ChildContent } else { @Label }
    }</span>

@code {
    /// <summary>Colour axis.</summary>
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;

    /// <summary>Shape/content — numeric count, short label, or a bare dot.</summary>
    [Parameter] public BadgeKind Kind { get; set; } = BadgeKind.Label;

    /// <summary>Count/label text; projected <see cref="ChildContent"/> overrides it. Ignored for Dot.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Rich count/label content; overrides <see cref="Label"/>. Ignored for Dot.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host span.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? DotAriaHidden => Kind == BadgeKind.Dot ? "true" : null;

    private string HostClass =>
        $"lucent-badge lucent-badge--{Kind.ToToken()} lucent-badge--{Variant.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
