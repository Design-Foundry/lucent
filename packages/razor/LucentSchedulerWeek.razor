@*
    LucentSchedulerWeek — emits the `.lucent-scheduler-week` contract (styles/components/scheduler-views.css).
    A week time-grid: hour gutter + 7 day columns of time-positioned LucentEventBlock + a now-line.
    Prev/next navigate weeks and raise WeekStartChanged (requires an interactive render mode).
*@

<div class="lucent-scheduler-week">
    <div class="lucent-scheduler__header">
        <span class="lucent-scheduler__title">@Title</span>
        <div class="lucent-scheduler__nav">
            <LucentIconButton Icon="chevron_left" Variant="LucentButtonVariant.Ghost" Size="IconButtonSize.Sm" AriaLabel="Previous week" @onclick="() => Shift(-1)" />
            <LucentIconButton Icon="chevron_right" Variant="LucentButtonVariant.Ghost" Size="IconButtonSize.Sm" AriaLabel="Next week" @onclick="() => Shift(1)" />
        </div>
    </div>
    <div class="lucent-scheduler-week__head">
        <span></span>
        @foreach (var h in Heads)
        {
            <span class="lucent-scheduler-week__day-head@(h.Today ? " is-today" : "")">@h.Label</span>
        }
    </div>
    <div class="lucent-scheduler-week__body">
        <div class="lucent-scheduler-week__gutter">
            @foreach (var h in Hours)
            {
                <span class="lucent-scheduler-week__hour" style="height:@(HourH)px">@HourLabel(h)</span>
            }
        </div>
        @foreach (var col in Columns)
        {
            <div class="lucent-scheduler-week__col@(col.Today ? " is-today" : "")" style="height:@(BodyHeight)px">
                @foreach (var h in Hours)
                {
                    <div class="lucent-scheduler-week__slot"></div>
                }
                @foreach (var e in col.Events)
                {
                    <div class="lucent-scheduler-week__event" style="top:@(e.Top)px;height:@(e.Height)px">
                        <LucentEventBlock Category="e.Category" Title="e.Title" Time="e.Time" />
                    </div>
                }
                @if (col.ShowNow)
                {
                    <div class="lucent-scheduler-week__now" style="top:@(NowTop)px"></div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Any date within the week to display; snapped to that week's Monday.</summary>
    [Parameter] public DateTime? WeekStart { get; set; }

    /// <summary>Raised when prev/next changes the displayed week (the new Monday).</summary>
    [Parameter] public EventCallback<DateTime> WeekStartChanged { get; set; }

    /// <summary>Events positioned by time within their day column.</summary>
    [Parameter] public IReadOnlyList<TimedEvent> Events { get; set; } = [];

    [Parameter] public int StartHour { get; set; } = 8;
    [Parameter] public int EndHour { get; set; } = 18;

    /// <summary>Shows the red "now" line in today's column.</summary>
    [Parameter] public bool ShowNow { get; set; } = true;

    private const int HourH = 44;
    private static readonly string[] Wd = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private DateTime? _weekStart;
    private DateTime Monday
    {
        get { var b = _weekStart ?? WeekStart ?? DateTime.Today; var off = ((int)b.DayOfWeek + 6) % 7; return b.Date.AddDays(-off); }
    }

    private IEnumerable<DateTime> Days => Enumerable.Range(0, 7).Select(i => Monday.AddDays(i));
    private IReadOnlyList<int> Hours => Enumerable.Range(StartHour, Math.Max(0, EndHour - StartHour)).ToList();
    private int BodyHeight => Hours.Count * HourH;
    private double NowDec => DateTime.Now.Hour + DateTime.Now.Minute / 60.0;
    private int NowTop => (int)Math.Round((NowDec - StartHour) * HourH);
    private string Title { get { var d = Days.ToArray(); return $"{d[0].ToString("MMM d", CultureInfo.InvariantCulture)} – {d[6].ToString("MMM d", CultureInfo.InvariantCulture)}, {d[6].Year}"; } }

    private static string HourLabel(int h) => $"{((h + 11) % 12) + 1}{(h < 12 ? "a" : "p")}";

    private record HeadVM(string Label, bool Today);
    private IEnumerable<HeadVM> Heads
    {
        get { var today = DateTime.Today; return Days.Select(d => new HeadVM($"{Wd[((int)d.DayOfWeek + 6) % 7]} {d.Day}", d.Date == today)); }
    }

    private record EventVM(int Top, int Height, EventCategory Category, string Title, string Time);
    private record ColVM(bool Today, bool ShowNow, IReadOnlyList<EventVM> Events);
    private IEnumerable<ColVM> Columns
    {
        get
        {
            var today = DateTime.Today;
            var nowInRange = ShowNow && NowDec >= StartHour && NowDec <= EndHour;
            foreach (var day in Days)
            {
                var isToday = day.Date == today;
                var evs = Events
                    .Where(e => e.Date.Date == day.Date)
                    .Select(e => new EventVM(
                        (int)Math.Round((e.StartHour - StartHour) * HourH),
                        (int)Math.Round((e.EndHour - e.StartHour) * HourH),
                        e.Category, e.Title, HourLabel((int)Math.Floor(e.StartHour))))
                    .ToList();
                yield return new ColVM(isToday, isToday && nowInRange, evs);
            }
        }
    }

    private async Task Shift(int deltaWeeks)
    {
        _weekStart = Monday.AddDays(deltaWeeks * 7);
        await WeekStartChanged.InvokeAsync(_weekStart.Value);
    }
}
