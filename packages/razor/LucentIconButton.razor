@*
    LucentIconButton — emits the `.lucent-icon-button` contract (styles/components/icon-button.css).

    A square, icon-only button sharing the button's six variants. Static-SSR friendly: a real
    <button>, so Type="submit" works inside a form with no JS. Always give it an AriaLabel —
    there is no text to name it. Pass-through attributes (@onclick, name, …) land on the button.
*@

<span class="@HostClass">
    <button class="lucent-icon-button__inner"
            type="@Type"
            disabled="@Disabled"
            aria-label="@(string.IsNullOrEmpty(AriaLabel) ? null : AriaLabel)"
            @attributes="AdditionalAttributes">
        <LucentIcon Name="@Icon" Size="@Size.ToIconSize()" />
    </button>
</span>

@code {
    /// <summary>Material Icons ligature name (the kit-standard <c>icon</c> shorthand).</summary>
    [Parameter] public string Icon { get; set; } = "";

    /// <summary>Visual variant — shares the button's variant scale.</summary>
    [Parameter] public LucentButtonVariant Variant { get; set; } = LucentButtonVariant.Primary;

    /// <summary>Size (sm/md/lg).</summary>
    [Parameter] public IconButtonSize Size { get; set; } = IconButtonSize.Md;

    /// <summary>Native button type: <c>button</c> (default), <c>submit</c>, or <c>reset</c>.</summary>
    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name — required, since the button has no visible text.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the inner button.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-icon-button lucent-icon-button--{Variant.ToToken()} lucent-icon-button--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
