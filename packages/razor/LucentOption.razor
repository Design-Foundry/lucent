@*
    LucentOption — emits the `.lucent-option` contract (styles/components/option.css).

    A listbox row, used inside LucentSelect's dropdown (and usable standalone). `Selected` is
    the chosen value; `Active` is the transient keyboard highlight. Raises OnOptionSelect.
*@

<div class="@HostClass"
     role="option"
     aria-selected="@(Selected ? "true" : "false")"
     aria-disabled="@(Disabled ? "true" : null)"
     @onclick="OnClick"
     @attributes="AdditionalAttributes">
    <span class="lucent-option__label">@Label</span>
</div>

@code {
    /// <summary>Row text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The value this option carries.</summary>
    [Parameter] public object? Value { get; set; }

    /// <summary>Chosen state (aria-selected).</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Keyboard-highlighted (aria-activedescendant target). Visual only.</summary>
    [Parameter] public bool Active { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised with <see cref="Value"/> when the option is activated.</summary>
    [Parameter] public EventCallback<object?> OnOptionSelect { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnClick() => Disabled ? Task.CompletedTask : OnOptionSelect.InvokeAsync(Value);

    private string HostClass =>
        "lucent-option"
        + (Selected ? " is-selected" : "")
        + (Active ? " is-active" : "")
        + (Disabled ? " is-disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
