@*
    LucentSchedulerAgenda — emits the `.lucent-scheduler-agenda` contract (styles/components/scheduler-views.css).
    A grouped list: events bucketed by day, each day a header + LucentAgendaRow rows; empty state otherwise.
*@

<div class="lucent-scheduler-agenda">
    <div class="lucent-scheduler__header">
        <span class="lucent-scheduler__title">@Title</span>
    </div>
    @{ var groups = Groups; }
    @if (groups.Count == 0)
    {
        <div class="lucent-scheduler-agenda__empty">@EmptyText</div>
    }
    else
    {
        @foreach (var g in groups)
        {
            <div class="lucent-scheduler-agenda__group">
                <span class="lucent-scheduler-agenda__day@(g.Today ? " is-today" : "")">@g.Label</span>
                @foreach (var e in g.Items)
                {
                    <LucentAgendaRow Category="e.Category" Time="@(e.Time ?? "")" Title="e.Label" />
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>Events to list, grouped by day.</summary>
    [Parameter] public IReadOnlyList<DatedEvent> Events { get; set; } = [];

    /// <summary>Toolbar title.</summary>
    [Parameter] public string Title { get; set; } = "Upcoming";

    /// <summary>Shown when there are no events.</summary>
    [Parameter] public string EmptyText { get; set; } = "Nothing scheduled";

    private record GroupVM(string Label, bool Today, IReadOnlyList<DatedEvent> Items);

    private IReadOnlyList<GroupVM> Groups
    {
        get
        {
            var today = DateTime.Today;
            var map = new Dictionary<DateTime, List<DatedEvent>>();
            var order = new List<DateTime>();
            foreach (var e in Events.OrderBy(e => e.Date))
            {
                var k = e.Date.Date;
                if (!map.TryGetValue(k, out var list)) { list = new(); map[k] = list; order.Add(k); }
                list.Add(e);
            }
            return order
                .Select(k => new GroupVM(
                    k == today ? "Today" : k.ToString("dddd, MMM d", CultureInfo.InvariantCulture),
                    k == today,
                    map[k]))
                .ToList();
        }
    }
}
