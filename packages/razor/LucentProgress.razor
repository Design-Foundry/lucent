@*
    LucentProgress — emits the `.lucent-progress` contract (styles/components/progress.css).

    A linear progress bar — determinate (Value/Max) or a sliding Indeterminate sliver
    for unknown-duration work.
*@

<div class="@HostClass"
     role="progressbar"
     aria-valuemin="@(Indeterminate ? null : "0")"
     aria-valuemax="@(Indeterminate ? null : Max.ToString(Culture))"
     aria-valuenow="@(Indeterminate ? null : Value.ToString(Culture))"
     aria-label="@Label"
     @attributes="AdditionalAttributes">
    <span class="lucent-progress__bar" style="@BarStyle"></span>
</div>

@code {
    /// <summary>Current value (ignored when <see cref="Indeterminate"/>).</summary>
    [Parameter] public double Value { get; set; }

    /// <summary>Maximum value. Defaults to 100.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Show a sliding indeterminate sliver instead of a determinate fill.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Accessible name for the bar (e.g. "Uploading").</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;

    private double Pct => Math.Clamp(Value / (Max == 0 ? 100 : Max) * 100, 0, 100);

    private string? BarStyle => Indeterminate ? null : $"width:{Pct.ToString(Culture)}%";

    private string HostClass =>
        "lucent-progress"
        + (Indeterminate ? " lucent-progress--indeterminate" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
