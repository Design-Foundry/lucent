@*
    LucentEventChip — emits the `.lucent-event-chip` contract (styles/components/scheduler.css).
    A compact event pill shown inside month-view day cells, colored by category.
*@

<span class="@HostClass">
    @if (!string.IsNullOrEmpty(Time))
    {
        <span class="lucent-event-chip__time">@Time</span>
    }
    <span class="lucent-event-chip__label">@Label</span>
</span>

@code {
    /// <summary>Event kind — sets the category color.</summary>
    [Parameter] public EventCategory Category { get; set; } = EventCategory.Work;

    /// <summary>Event label.</summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Optional leading time (e.g. "9a").</summary>
    [Parameter] public string? Time { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    private string HostClass =>
        $"lucent-event-chip lucent-event-chip--{Category.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
