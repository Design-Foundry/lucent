@*
    LucentSegmentedControl — emits the `.lucent-segmented-control` contract
    (styles/components/segmented-control.css).

    A compact inline single-select for a view/mode among a few peers (Day/Week/Month). Segments
    are toggle buttons (aria-pressed); supports @bind-Value.
*@
@typeparam TValue

<div class="@HostClass" role="group" aria-label="@Label" @attributes="AdditionalAttributes">
    @foreach (var opt in Options)
    {
        var selected = EqualityComparer<TValue>.Default.Equals(opt.Value, Value);
        <button type="button"
                class="lucent-segmented-control__segment@(selected ? " is-selected" : "")"
                aria-pressed="@(selected ? "true" : "false")"
                disabled="@opt.Disabled"
                @onclick="() => SelectAsync(opt)">
            @opt.Label
        </button>
    }
</div>

@code {
    /// <summary>The segments.</summary>
    [Parameter] public IEnumerable<SegmentedOption<TValue>> Options { get; set; } = Array.Empty<SegmentedOption<TValue>>();

    /// <summary>Selected value. Two-way bindable via <c>@bind-Value</c>.</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Accessible name for the group.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task SelectAsync(SegmentedOption<TValue> opt)
    {
        if (opt.Disabled) return;
        Value = opt.Value;
        await ValueChanged.InvokeAsync(opt.Value);
    }

    private string HostClass =>
        $"lucent-segmented-control lucent-segmented-control--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
