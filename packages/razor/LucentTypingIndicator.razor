@*
    LucentTypingIndicator — emits the `.lucent-typing-indicator` contract
    (styles/components/typing-indicator.css).

    Live dots shown where the next message will appear. Typing = a person is composing;
    Generating = the agent is producing (accent dots + an optional label).
*@

<div class="@HostClass" role="status" aria-live="polite" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    <span class="lucent-typing-indicator__dots" aria-hidden="true">
        <span class="lucent-typing-indicator__dot"></span>
        <span class="lucent-typing-indicator__dot"></span>
        <span class="lucent-typing-indicator__dot"></span>
    </span>
    @if (!string.IsNullOrEmpty(LabelText))
    {
        <span class="lucent-typing-indicator__label">@LabelText</span>
    }
</div>

@code {
    /// <summary>Mode — typing (person) or generating (agent).</summary>
    [Parameter] public TypingVariant Variant { get; set; } = TypingVariant.Typing;

    /// <summary>Optional label (defaults to "Generating…" for the generating variant).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string LabelText => !string.IsNullOrEmpty(Label)
        ? Label
        : (Variant == TypingVariant.Generating ? "Generating…" : "");

    private string AriaLabel => !string.IsNullOrEmpty(Label)
        ? Label
        : (Variant == TypingVariant.Generating ? "Generating" : "Typing");

    private string HostClass =>
        $"lucent-typing-indicator lucent-typing-indicator--{Variant.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
