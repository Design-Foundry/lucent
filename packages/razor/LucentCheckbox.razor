@*
    LucentCheckbox — emits the `.lucent-checkbox` contract (styles/components/checkbox.css).

    Backed by a real <input type="checkbox">, so the checked tick is pure CSS (:has(:checked))
    and it posts in a form with no JS. The check glyph is always rendered (so a client-side
    toggle reveals it); the indeterminate dash is a server-set state. Pass-through attributes
    (name, value, @bind, …) land on the input.
*@

<label class="@HostClass">
    <input type="checkbox"
           class="lucent-checkbox__input"
           checked="@Checked"
           disabled="@Disabled"
           @attributes="AdditionalAttributes" />
    <span class="lucent-checkbox__box">
        <LucentIcon Name="check" Size="IconSize.Sm" Class="lucent-checkbox__icon lucent-checkbox__icon--check" />
        @if (Indeterminate)
        {
            <LucentIcon Name="remove" Size="IconSize.Sm" Class="lucent-checkbox__icon lucent-checkbox__icon--dash" />
        }
    </span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lucent-checkbox__label">@Label</span>
    }
</label>

@code {
    /// <summary>Initial checked state. Under static SSR the browser tracks changes; in a form it posts.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Indeterminate (mixed) state — shows a dash and wins over checked.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Optional trailing label text.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the input.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-checkbox lucent-checkbox--{Size.ToToken()}"
        + (Indeterminate ? " is-indeterminate" : "")
        + (Disabled ? " is-disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
