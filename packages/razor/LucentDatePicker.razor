@*
    LucentDatePicker — emits the `.lucent-date-picker` contract (styles/components/date-picker.css).

    A field that opens the Calendar in a popover to pick a single date. Two-way bind the chosen
    date with @bind-Value. The popover renders inline under the field (anchored by CSS); requires
    an interactive render mode (the suite's console runs Blazor Server interactivity).
*@

<div class="@HostClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lucent-date-picker__label">@Label</span>
    }

    <div class="lucent-date-picker__field">
        <button type="button"
                class="lucent-date-picker__trigger@(_open ? " lucent-date-picker__trigger--focus" : "")"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <LucentIcon Class="lucent-date-picker__icon" Name="calendar_today" Size="IconSize.Sm" />
            <span class="lucent-date-picker__value@(Value.HasValue ? "" : " is-placeholder")">@DisplayText</span>
            <LucentIcon Class="lucent-date-picker__caret" Name="arrow_drop_down" Size="IconSize.Sm" />
        </button>

        @if (_open)
        {
            <div class="lucent-date-picker__popover">
                <LucentCalendar Month="Month" Value="Value" Min="Min" Max="Max" ValueChanged="Choose" />
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Selected date (two-way bindable with @bind-Value).</summary>
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    /// <summary>Field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown when no date is selected.</summary>
    [Parameter] public string Placeholder { get; set; } = "Select date";

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Selectable bounds; days outside are disabled in the Calendar.</summary>
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    private bool _open;

    private DateTime Month => Value ?? DateTime.Today;
    private string DisplayText => Value?.ToString("MMM d, yyyy") ?? Placeholder;

    private string HostClass =>
        $"lucent-date-picker lucent-date-picker--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private void Toggle() => _open = !_open;

    private async Task Choose(DateTime date)
    {
        Value = date;
        await ValueChanged.InvokeAsync(date);
        _open = false;
    }
}
