@*
    LucentTimePicker — emits the `.lucent-time-picker` contract (styles/components/time-picker.css).

    A field that opens an hour / minute / period column popover to pick a time of day. Two-way bind
    the chosen time (a <c>TimeOnly</c>) with @bind-Value. The popover renders inline under the field
    (anchored by CSS); requires an interactive render mode (the suite's console runs Blazor Server).
*@

<div class="@HostClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lucent-time-picker__label">@Label</span>
    }

    <div class="lucent-time-picker__field">
        <button type="button"
                class="lucent-time-picker__trigger@(_open ? " lucent-time-picker__trigger--focus" : "")"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <LucentIcon Class="lucent-time-picker__icon" Name="schedule" Size="IconSize.Sm" />
            <span class="lucent-time-picker__value@(Value.HasValue ? "" : " is-placeholder")">@DisplayText</span>
            <LucentIcon Class="lucent-time-picker__caret" Name="arrow_drop_down" Size="IconSize.Sm" />
        </button>

        @if (_open)
        {
            <div class="lucent-time-picker__popover">
                <div class="lucent-time-picker__col" role="listbox" aria-label="Hour">
                    @foreach (var h in Hours)
                    {
                        var hour = h;
                        <button type="button" class="lucent-time-picker__cell@(SelectedHour12 == hour ? " is-selected" : "")" @onclick="() => PickHour(hour)">@hour</button>
                    }
                </div>
                <div class="lucent-time-picker__col" role="listbox" aria-label="Minute">
                    @foreach (var m in Minutes)
                    {
                        var min = m;
                        <button type="button" class="lucent-time-picker__cell@(Value?.Minute == min ? " is-selected" : "")" @onclick="() => PickMinute(min)">@min.ToString("D2")</button>
                    }
                </div>
                <div class="lucent-time-picker__col" role="listbox" aria-label="Period">
                    @foreach (var p in Periods)
                    {
                        var period = p;
                        <button type="button" class="lucent-time-picker__cell@(SelectedPeriod == period ? " is-selected" : "")" @onclick="() => PickPeriod(period)">@period</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Selected time of day (two-way bindable with @bind-Value).</summary>
    [Parameter] public TimeOnly? Value { get; set; }
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }

    /// <summary>Field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown when no time is selected.</summary>
    [Parameter] public string Placeholder { get; set; } = "Select time";

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Minute granularity in the minute column.</summary>
    [Parameter] public int MinuteStep { get; set; } = 5;

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    private bool _open;

    private static readonly int[] Hours = Enumerable.Range(1, 12).ToArray();
    private static readonly string[] Periods = { "AM", "PM" };
    private IEnumerable<int> Minutes
    {
        get { var s = MinuteStep > 0 ? MinuteStep : 5; for (var m = 0; m < 60; m += s) yield return m; }
    }

    private int? SelectedHour12 => Value is { } v ? To12h(v.Hour) : null;
    private string? SelectedPeriod => Value is { } v ? (v.Hour < 12 ? "AM" : "PM") : null;
    private string DisplayText => Value is { } v ? $"{To12h(v.Hour)}:{v.Minute:D2} {(v.Hour < 12 ? "AM" : "PM")}" : Placeholder;

    private string HostClass =>
        $"lucent-time-picker lucent-time-picker--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private static int To12h(int h) => ((h + 11) % 12) + 1;
    private static int From12h(int h12, string period) => period == "PM" ? (h12 % 12) + 12 : h12 % 12;

    private void Toggle() => _open = !_open;

    private async Task Commit(TimeOnly t)
    {
        Value = t;
        await ValueChanged.InvokeAsync(t);
    }

    private Task PickHour(int h12)
    {
        var v = Value;
        var period = v is { } vv ? (vv.Hour < 12 ? "AM" : "PM") : "AM";
        return Commit(new TimeOnly(From12h(h12, period), v?.Minute ?? 0));
    }

    private Task PickMinute(int m) => Commit(new TimeOnly(Value?.Hour ?? 9, m));

    private Task PickPeriod(string p)
    {
        var v = Value;
        var h12 = v is { } vv ? To12h(vv.Hour) : 12;
        return Commit(new TimeOnly(From12h(h12, p), v?.Minute ?? 0));
    }
}
