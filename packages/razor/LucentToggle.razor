@*
    LucentToggle — emits the `.lucent-toggle` contract (styles/components/toggle.css).

    A switch backed by a real <input type="checkbox">, so the checked visual is pure CSS
    (:has(:checked)) and it posts in a form with no JS. The wrapping <label> names the input;
    pass-through attributes (name, value, @bind, …) land on the input.
*@

<label class="@HostClass">
    <input type="checkbox"
           class="lucent-toggle__input"
           role="switch"
           checked="@Checked"
           disabled="@Disabled"
           @attributes="AdditionalAttributes" />
    <span class="lucent-toggle__track"><span class="lucent-toggle__thumb"></span></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lucent-toggle__label">@Label</span>
    }
</label>

@code {
    /// <summary>Initial checked state. Under static SSR the browser tracks changes; in a form it posts.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Size (md/sm).</summary>
    [Parameter] public ToggleSize Size { get; set; } = ToggleSize.Md;

    /// <summary>Optional trailing label text.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the input.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-toggle lucent-toggle--{Size.ToToken()}"
        + (Disabled ? " is-disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
