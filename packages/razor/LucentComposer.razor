@*
    LucentComposer — emits the `.lucent-composer` contract (styles/components/composer.css).

    The message input for chat & messaging: a borderless textarea + a send button that morphs —
    send → spinner (Sending) → stop ■ (while the agent Streams). Interactive (@bind-Value + click
    handlers). Enter-to-send is left to the app (or use the Web Components kit) since Blazor can't
    conditionally preventDefault per keystroke without JS interop.
*@

<div class="@HostClass" @attributes="AdditionalAttributes">
    <textarea class="lucent-composer__field"
              rows="1"
              placeholder="@Placeholder"
              value="@Value"
              disabled="@Disabled"
              @oninput="OnInput"></textarea>
    <div class="lucent-composer__actions">
        @if (Streaming)
        {
            <LucentIconButton Icon="stop" Variant="LucentButtonVariant.Primary" Size="@BtnSize"
                              AriaLabel="Stop generating" @onclick="OnStop" />
        }
        else if (Sending)
        {
            <LucentSpinner Size="SpinnerSize.Sm" />
        }
        else
        {
            <LucentIconButton Icon="arrow_upward" Variant="LucentButtonVariant.Primary" Size="@BtnSize"
                              AriaLabel="Send" Disabled="@(!CanSend)" @onclick="OnSend" />
        }
    </div>
</div>

@code {
    /// <summary>Message text. Two-way bindable via <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised when <see cref="Value"/> changes.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Raised with the trimmed message when sent.</summary>
    [Parameter] public EventCallback<string> Send { get; set; }

    /// <summary>Raised when the stop button is clicked (while streaming).</summary>
    [Parameter] public EventCallback Stop { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string Placeholder { get; set; } = "Message…";

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Submitting — shows a spinner in place of send.</summary>
    [Parameter] public bool Sending { get; set; }

    /// <summary>The agent is streaming — send morphs to Stop.</summary>
    [Parameter] public bool Streaming { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool CanSend => !Disabled && !Sending && !Streaming && !string.IsNullOrWhiteSpace(Value);

    private IconButtonSize BtnSize => Size switch
    {
        ControlSize.Lg => IconButtonSize.Lg,
        ControlSize.Md => IconButtonSize.Md,
        _ => IconButtonSize.Sm,
    };

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnSend()
    {
        if (!CanSend) return;
        var text = Value!.Trim();
        Value = "";
        await ValueChanged.InvokeAsync(Value);
        await Send.InvokeAsync(text);
    }

    private async Task OnStop() => await Stop.InvokeAsync();

    private string HostClass =>
        $"lucent-composer lucent-composer--{Size.ToToken()}"
        + (Disabled ? " lucent-composer--disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
