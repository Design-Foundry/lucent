@*
    LucentMenuItem — emits the `.lucent-menu-item` contract (styles/components/menu-item.css).

    A row in a LucentMenu. Attach your action with @onclick (pass-through); the parent menu
    closes on click. Variant="Danger" styles a destructive action in red.
*@

<div class="@HostClass" role="menuitem" tabindex="0" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <LucentIcon Class="lucent-menu-item__icon" Name="@Icon" Size="IconSize.Sm" />
    }
    <span class="lucent-menu-item__label">@Label</span>
</div>

@code {
    /// <summary>Item text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Leading icon.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Keyboard-highlighted state.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Visual variant — Danger for destructive actions.</summary>
    [Parameter] public MenuItemVariant Variant { get; set; } = MenuItemVariant.Default;

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes (notably @onclick); applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        "lucent-menu-item"
        + (Active ? " is-active" : "")
        + (Variant == MenuItemVariant.Danger ? " is-danger" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
