@*
    LucentIcon — emits the `.lucent-icon` contract (styles/components/icon.css).

    Renders a single Material Icons glyph by ligature name (the `material-icons` font must
    be loaded globally by the host). The kit's icon primitive:
    every component with an `Icon` shorthand renders one of these internally.

    Decorative by default (aria-hidden); set AriaLabel only when the glyph carries meaning
    on its own, which makes the host a labelled role="img".
*@

<span class="@HostClass"
      aria-hidden="@AriaHiddenAttr"
      role="@RoleAttr"
      aria-label="@AriaLabelAttr"
      @attributes="AdditionalAttributes">
    <span class="material-icons lucent-icon__glyph">@Name</span>
</span>

@code {
    /// <summary>Material Icons ligature name (e.g. <c>settings</c>, <c>more_vert</c>).</summary>
    [Parameter] public string Name { get; set; } = "widgets";

    /// <summary>Glyph size.</summary>
    [Parameter] public IconSize Size { get; set; } = IconSize.Md;

    /// <summary>Set only when the icon conveys meaning on its own. Leave null/empty for decorative icons.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host span.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool Meaningful => !string.IsNullOrEmpty(AriaLabel);
    private string? AriaHiddenAttr => Meaningful ? null : "true";
    private string? RoleAttr => Meaningful ? "img" : null;
    private string? AriaLabelAttr => Meaningful ? AriaLabel : null;

    private string HostClass =>
        $"lucent-icon lucent-icon--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
