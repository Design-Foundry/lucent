@*
    LucentMessageBubble — emits the `.lucent-message-bubble` contract
    (styles/components/message-bubble.css).

    A chat/message bubble for AI chat and human messaging. User is accent-tinted with a tail;
    assistant/other are surface bubbles; system is a quiet centered note. Body is projected
    (rich content). Left/right row alignment is done by the container at the usage site.
*@

<div class="@HostClass" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Author) || !string.IsNullOrEmpty(Timestamp))
    {
        <div class="lucent-message-bubble__meta">
            @if (!string.IsNullOrEmpty(Author))
            {
                <span class="lucent-message-bubble__author">@Author</span>
            }
            @if (!string.IsNullOrEmpty(Timestamp))
            {
                <span class="lucent-message-bubble__time">@Timestamp</span>
            }
        </div>
    }
    <div class="lucent-message-bubble__body">@ChildContent</div>
</div>

@code {
    /// <summary>Sender role.</summary>
    [Parameter] public MessageRole Role { get; set; } = MessageRole.Assistant;

    /// <summary>Grouping (standalone shows a tail; continuation drops it).</summary>
    [Parameter] public MessageGroup Group { get; set; } = MessageGroup.Standalone;

    /// <summary>Optional author name in the meta line.</summary>
    [Parameter] public string? Author { get; set; }

    /// <summary>Optional timestamp string in the meta line.</summary>
    [Parameter] public string? Timestamp { get; set; }

    /// <summary>The message body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-message-bubble lucent-message-bubble--{Role.ToToken()} lucent-message-bubble--{Group.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
