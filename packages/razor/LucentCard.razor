@*
    LucentCard — emits the `.lucent-card` contract (styles/components/card.css).
    A glass surface container that stacks its content with a gap. Content projects in.
*@

<div class="@HostClass" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>Card content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        "lucent-card" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
