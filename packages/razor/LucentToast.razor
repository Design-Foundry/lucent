@*
    LucentToast — emits the `.lucent-toast` contract (styles/components/toast.css).

    A status notification (info/success/warning/error) with a title, optional message, and an
    optional close button. role=status / aria-live=polite. (Stacking/auto-dismiss is a
    host/service concern, not part of this presentational component.)
*@

<div class="@HostClass" role="status" aria-live="polite" @attributes="AdditionalAttributes">
    <div class="lucent-toast__header">
        <span class="lucent-toast__title">@Title</span>
        @if (Closable)
        {
            <LucentIconButton Class="lucent-toast__close" Icon="close" Variant="LucentButtonVariant.Ghost" Size="IconButtonSize.Sm" AriaLabel="Dismiss" @onclick="OnClosed" />
        }
    </div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="lucent-toast__message">@Message</p>
    }
</div>

@code {
    /// <summary>Toast title.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional secondary message.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Severity variant.</summary>
    [Parameter] public ToastVariant Variant { get; set; } = ToastVariant.Informative;

    /// <summary>Whether to show the close button.</summary>
    [Parameter] public bool Closable { get; set; } = true;

    /// <summary>Raised when dismissed.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-toast lucent-toast--{Variant.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
