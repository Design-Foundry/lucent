@*
    LucentButton — emits the `.lucent-button` contract (styles/components/button.css).

    Two activation roles over one appearance contract (see the Foundry-model note
    "activation roles"): the visual variant/size is orthogonal to *what activating it does*.
      • act (default)  — no Href ⇒ a real <button>. Static-SSR friendly: inside a <form>
        with Type="submit" it works with no JS; fires @onclick with interactivity.
      • navigate        — Href set ⇒ an <a href> (link semantics), not a <button>.
    The outer element is the density/variant host (the Angular `:host`); the inner element
    carries `.lucent-button__inner` (the pill). Pass-through attributes land on the
    *interactive* element — the inner <button> for act, the host <a> for navigate.
*@

@if (Href is null)
{
    <span class="@HostClass">
        <button class="lucent-button__inner"
                type="@Type"
                disabled="@Disabled"
                @attributes="AdditionalAttributes">
            @ChildContent
        </button>
    </span>
}
else
{
    @* The anchor IS the interactive element, so it hosts both the contract classes and the
       pass-through attrs; `.lucent-button`'s `text-decoration: none` keeps the label
       un-underlined. Type/Disabled don't apply to a link and are ignored. *@
    <a class="@HostClass"
       href="@Href"
       @attributes="AdditionalAttributes">
        <span class="lucent-button__inner">@ChildContent</span>
    </a>
}

@code {
    /// <summary>Button label / content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Density size — controls at the same size align side-by-side.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Visual variant.</summary>
    [Parameter] public LucentButtonVariant Variant { get; set; } = LucentButtonVariant.Primary;

    /// <summary>Native button type: <c>button</c> (default), <c>submit</c>, or <c>reset</c>.</summary>
    [Parameter] public string Type { get; set; } = "button";

    /// <summary>
    /// Navigation destination. When set, the control realizes the <b>navigate</b> role —
    /// it renders an <c>&lt;a href&gt;</c> (link semantics) instead of a <c>&lt;button&gt;</c>.
    /// Leave null for the <b>act</b> role (a <c>&lt;button&gt;</c> that submits a form or fires
    /// <c>@onclick</c>). Both roles share the same visual variant/size contract.
    /// </summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the inner button.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-button lucent-button--{Variant.ToToken()} lucent-button--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
