@*
    LucentNavDivider — emits the `.lucent-nav-divider` contract (styles/components/nav-divider.css).
    A full-width hairline between groups in a nav rail.
    DEPRECATED — use <LucentDivider Variant="DividerVariant.Plain" /> (the unified Divider) instead.
*@
@attribute [System.Obsolete("Use LucentDivider with Variant=DividerVariant.Plain (the unified Divider) instead.")]

<div class="lucent-nav-divider" role="separator" @attributes="AdditionalAttributes"></div>

@code {
    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
