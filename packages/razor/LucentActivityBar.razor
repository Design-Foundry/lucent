@*
    LucentActivityBar — emits the `.lucent-activity-bar` contract (styles/components/activity-bar.css).
    Horizontal glass container for a dense cluster of controls. Content projects in.
*@

<div class="@HostClass" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>Bar content (icon buttons, dividers, etc.).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        "lucent-activity-bar" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
