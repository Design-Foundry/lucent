@*
    LucentTable — emits the `.lucent-table` contract (styles/components/table.css).

    Renders a real <table> so semantics/keyboard/a11y come for free; author the
    <thead>/<tbody>/<tr>/<th>/<td> as ChildContent. Cells hold any content (avatar,
    status-tag, icon-button). Column alignment via `.lucent-table__cell--right|center`.
*@

<table class="@HostClass" @attributes="AdditionalAttributes">
    @ChildContent
</table>

@code {
    /// <summary>The table's <c>thead</c>/<c>tbody</c> markup.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the table element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        "lucent-table" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
