@*
    LucentChip — emits the `.lucent-chip` contract (styles/components/chip.css).

    A pill: `Tag` prepends a hash glyph, `Action` appends a close button (raises OnClosed),
    `Active` is the accent-filled selected state. Pass-through attributes land on the host.
*@

<span class="@HostClass" @attributes="AdditionalAttributes">
    @if (Type == ChipType.Tag)
    {
        <LucentIcon Name="tag" Size="IconSize.Sm" />
    }
    <span class="lucent-chip__label">@Label</span>
    @if (Type == ChipType.Action)
    {
        <button type="button"
                class="lucent-chip__close"
                aria-label="@(string.IsNullOrEmpty(Label) ? "Remove" : $"Remove {Label}")"
                @onclick="OnClosed">
            <LucentIcon Name="close" Size="IconSize.Sm" />
        </button>
    }
</span>

@code {
    /// <summary>Visual type.</summary>
    [Parameter] public ChipType Type { get; set; } = ChipType.Default;

    /// <summary>Density size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Chip text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Raised when the close button (Action type) is activated.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host span.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-chip lucent-chip--{Type.ToToken()} lucent-chip--{Size.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
