@*
    LucentTooltip — emits the `.lucent-tooltip` contract (styles/components/tooltip.css).

    Wraps a focusable trigger; the bubble shows on hover and keyboard focus via pure CSS
    (:hover / :focus-within), so it works under static SSR with no JS. Sets aria-describedby
    on the wrapper so AT announces the description. (The Angular kit instead applies a
    [dfTooltip] directive that portals the same .lucent-tooltip bubble into a CDK overlay.)
*@

<span class="lucent-tooltip-host"
      aria-describedby="@(HasText ? Id : null)"
      @attributes="AdditionalAttributes">
    @ChildContent
    @if (HasText)
    {
        <span class="lucent-tooltip lucent-tooltip--@Position.ToToken()" role="tooltip" id="@Id">@Text</span>
    }
</span>

@code {
    /// <summary>Tooltip text. When null/empty, no bubble is rendered.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Placement relative to the trigger.</summary>
    [Parameter] public TooltipPosition Position { get; set; } = TooltipPosition.Top;

    /// <summary>The trigger element(s) the tooltip describes.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Bubble id; a unique one is generated when not supplied (links trigger ↔ bubble).</summary>
    [Parameter] public string Id { get; set; } = $"lt-{Guid.NewGuid():N}";

    /// <summary>Pass-through attributes; applied to the wrapper.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasText => !string.IsNullOrEmpty(Text);
}
