@*
    LucentRadio — emits the `.lucent-radio` contract (styles/components/radio.css).

    A single radio inside a <LucentRadioGroup>. Backed by a real <input type="radio"> sharing
    the group's name, so the filled dot is pure CSS (:has(:checked)) and it posts in a form
    with no JS. Reads size/selection/disabled from the cascaded group.
*@
@typeparam TValue

<label class="@HostClass">
    <input type="radio"
           class="lucent-radio__input"
           name="@Group?.EffectiveName"
           checked="@IsChecked"
           disabled="@IsDisabled"
           @onchange="OnChange"
           @attributes="AdditionalAttributes" />
    <span class="lucent-radio__circle"></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lucent-radio__label">@Label</span>
    }
</label>

@code {
    [CascadingParameter] public LucentRadioGroup<TValue>? Group { get; set; }

    /// <summary>The identity this radio contributes to the group's value.</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Optional trailing label text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Per-radio density override; otherwise inherits the group's <c>Size</c>.</summary>
    [Parameter] public ControlSize? Size { get; set; }

    /// <summary>Disables just this radio.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the input.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsChecked => Group is not null && Group.IsSelected(Value);
    private bool IsDisabled => Disabled || (Group?.GroupDisabled ?? false);
    private ControlSize EffectiveSize => Size ?? Group?.GroupSize ?? ControlSize.Md;

    private async Task OnChange(ChangeEventArgs e)
    {
        if (IsDisabled || Group is null) return;
        await Group.SelectAsync(Value);
    }

    private string HostClass =>
        $"lucent-radio lucent-radio--{EffectiveSize.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
