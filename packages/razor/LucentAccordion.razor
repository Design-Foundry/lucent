@*
    LucentAccordion — emits the `.lucent-accordion` contract (styles/components/accordion.css).

    A single disclosure: a header button that toggles a content region. Interactive (@onclick
    toggles Expanded); supports @bind-Expanded. Under static SSR it renders in whatever
    Expanded state the server sets (toggling then needs an interactive render mode).
*@

<div class="@HostClass" @attributes="AdditionalAttributes">
    <button type="button"
            class="lucent-accordion__header"
            id="@HeaderId"
            aria-expanded="@(Expanded ? "true" : "false")"
            aria-controls="@ContentId"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        <span class="lucent-accordion__title">@Title</span>
        <LucentIcon Name="expand_more" Size="IconSize.Sm" Class="lucent-accordion__chevron" />
    </button>

    <div class="lucent-accordion__content"
         id="@ContentId"
         role="region"
         aria-labelledby="@HeaderId"
         hidden="@(!Expanded)">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Header title.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Whether the content is shown. Two-way bindable via <c>@bind-Expanded</c>.</summary>
    [Parameter] public bool Expanded { get; set; }

    /// <summary>Raised when the disclosure toggles.</summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Disables the header.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The collapsible content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N");
    private string HeaderId => $"lucent-accordion-h-{_id}";
    private string ContentId => $"lucent-accordion-c-{_id}";

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        Expanded = !Expanded;
        await ExpandedChanged.InvokeAsync(Expanded);
    }

    private string HostClass =>
        "lucent-accordion"
        + (Expanded ? " is-expanded" : "")
        + (Disabled ? " is-disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
