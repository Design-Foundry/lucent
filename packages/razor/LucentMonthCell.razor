@*
    LucentMonthCell — emits the `.lucent-month-cell` contract (styles/components/scheduler.css).
    A tall month-grid day cell: a date badge + stacked event chips with a "+N more" overflow.
*@

<div class="@HostClass">
    <span class="lucent-month-cell__date">@Day</span>
    <div class="lucent-month-cell__events">
        @foreach (var e in Shown)
        {
            <LucentEventChip Category="e.Category" Label="e.Label" Time="e.Time" />
        }
        @if (Overflow > 0)
        {
            <span class="lucent-month-cell__more">+@Overflow more</span>
        }
    </div>
</div>

@code {
    /// <summary>The date number shown in the badge.</summary>
    [Parameter] public int Day { get; set; } = 1;

    /// <summary>Highlights the cell as today (accent badge + subtle tint).</summary>
    [Parameter] public bool Today { get; set; }

    /// <summary>Dims the cell as belonging to an adjacent month.</summary>
    [Parameter] public bool Outside { get; set; }

    /// <summary>Events to show; the first <see cref="MaxVisible"/> render as chips.</summary>
    [Parameter] public IReadOnlyList<SchedulerEvent> Events { get; set; } = [];

    /// <summary>How many chips to show before collapsing the rest into "+N more".</summary>
    [Parameter] public int MaxVisible { get; set; } = 2;

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    private IEnumerable<SchedulerEvent> Shown => Events.Take(MaxVisible);
    private int Overflow => Events.Count - Math.Min(Events.Count, MaxVisible);

    private string HostClass =>
        "lucent-month-cell"
        + (Today ? " lucent-month-cell--today" : "")
        + (Outside ? " lucent-month-cell--outside" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
