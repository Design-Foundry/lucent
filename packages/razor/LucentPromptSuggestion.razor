@*
    LucentPromptSuggestion — emits the `.lucent-prompt-suggestion` contract
    (styles/components/prompt-suggestion.css).

    A clickable starter for an empty chat. `Card` is roomy (icon + title + optional description);
    `Chip` is a compact pill. A real <button>; raises Selected with the prompt label.
*@

<button type="button" class="@HostClass" @onclick="OnClick" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <LucentIcon Name="@Icon" Size="IconSize.Sm" Class="lucent-prompt-suggestion__icon" />
    }
    <span class="lucent-prompt-suggestion__content">
        <span class="lucent-prompt-suggestion__title">@if (ChildContent is not null) { @ChildContent } else { @Label }</span>
        @if (!string.IsNullOrEmpty(Description) && Variant == PromptSuggestionVariant.Card)
        {
            <span class="lucent-prompt-suggestion__desc">@Description</span>
        }
    </span>
</button>

@code {
    /// <summary>Shape — card (roomy) or chip (compact pill).</summary>
    [Parameter] public PromptSuggestionVariant Variant { get; set; } = PromptSuggestionVariant.Card;

    /// <summary>The prompt text / title.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Rich title content; overrides <see cref="Label"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Second line (card variant only).</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Leading glyph.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Raised with the prompt label when chosen.</summary>
    [Parameter] public EventCallback<string> Selected { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the button.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnClick() => await Selected.InvokeAsync(Label);

    private string HostClass =>
        $"lucent-prompt-suggestion lucent-prompt-suggestion--{Variant.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
