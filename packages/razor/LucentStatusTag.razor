@*
    LucentStatusTag — emits the `.lucent-status-tag` contract (styles/components/status-tag.css).

    A pill badge on the status (severity) axis — success/neutral/warning/error. For destructive
    action intent use a button/menu-item `Tone`, not this (CONVENTIONS §6).
*@

<span class="@HostClass" @attributes="AdditionalAttributes"><span>@Label</span></span>

@code {
    /// <summary>Severity variant.</summary>
    [Parameter] public StatusTagVariant Variant { get; set; } = StatusTagVariant.Success;

    /// <summary>Badge text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra classes appended to the host element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through attributes; applied to the host span.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string HostClass =>
        $"lucent-status-tag lucent-status-tag--{Variant.ToToken()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
