{
  "name": "@design-foundry/lucent-wc",
  "version": "0.0.0-dev",
  "description": "Lucent design system — Web Components kit (Lit, Light DOM).",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Design-Foundry/lucent.git",
    "directory": "packages/web-components"
  },
  "sideEffects": ["**/*.ts", "**/*.js"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.dts.json",
    "pack:npm": "npm run build && npm pack"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
