{
  "name": "lucent-workspace",
  "version": "0.5.0",
  "description": "Lucent design system workspace: shared styles, Angular kit and showcase. The workspace itself is not published; styles/ and packages/angular are.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lib:build": "ng build lucent",
    "lib:watch": "ng build lucent --watch --configuration development",
    "lib:pack": "npm run lib:build && cd dist/lucent && npm pack",
    "showcase": "ng serve",
    "showcase:build": "ng build lucent-angular-showcase",
    "build": "npm run lib:build && npm run showcase:build",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "ng-packagr": "^22.0.1",
    "typescript": "~6.0.3"
  }
}
