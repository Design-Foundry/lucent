<!DOCTYPE html>
<html lang="en" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Material Icons — global font dependency for LucentIcon (consumer responsibility; see DISTRIBUTION.md §2c). *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
    @* The whole point of the showcase: the shared Lucent base, themed by data-theme above. *@
    <link rel="stylesheet" href="@Assets["_content/DesignFoundry.Lucent/lucent.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DesignFoundry.Lucent.Showcase.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    // Theme via ?theme=dark|light so Playwright can capture both with a plain navigation.
    // Read from the URL (not HttpContext) so it also resolves on interactive pages.
    private string Theme =>
        new Uri(Nav.Uri).Query.Contains("theme=dark") ? "dark" : "light";
}
