@* A titled block on a component page. <Example> rows sit inside it. *@
<section class="sc-section">
    <header class="sc-section__head">
        <h2 class="sc-section__title">@Title</h2>
        @if (!string.IsNullOrEmpty(Note))
        {
            <p class="sc-section__note">@Note</p>
        }
    </header>
    <div class="sc-section__body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
