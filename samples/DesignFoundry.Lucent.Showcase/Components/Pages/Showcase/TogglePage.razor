@page "/c/toggle"

<PageTitle>Toggle — Lucent</PageTitle>

<h1>Toggle</h1>
<p class="sc-page__lead"><code>LucentToggle</code> — a switch backed by a native checkbox (click works, no JS).</p>

<ShowcaseSection Title="States (md)">
    <Example Label="off"><LucentToggle Label="Notifications" /></Example>
    <Example Label="on"><LucentToggle Label="Notifications" Checked="true" /></Example>
    <Example Label="disabled off"><LucentToggle Label="Notifications" Disabled="true" /></Example>
    <Example Label="disabled on"><LucentToggle Label="Notifications" Checked="true" Disabled="true" /></Example>
</ShowcaseSection>

<ShowcaseSection Title="Small">
    <Example Label="off"><LucentToggle Size="ToggleSize.Sm" Label="Compact" /></Example>
    <Example Label="on"><LucentToggle Size="ToggleSize.Sm" Label="Compact" Checked="true" /></Example>
</ShowcaseSection>
