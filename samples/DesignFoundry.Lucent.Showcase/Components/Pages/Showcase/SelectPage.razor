@page "/c/select"
@rendermode InteractiveServer

<PageTitle>Select — Lucent</PageTitle>

<h1>Select</h1>
<p class="sc-page__lead"><code>LucentSelect</code> — interactive combobox (click or keyboard to open). This page runs Server-interactive.</p>

<ShowcaseSection Title="Default" Note="Click the trigger to open; selection updates the value.">
    <Example Column="true">
        <div style="width: 240px;">
            <LucentSelect Label="Workspace" Options="_options" @bind-Value="_value" Hint="Pick a workspace." />
        </div>
    </Example>
    <Example Label="selected value" Column="true">
        <span style="color: var(--color--semantic--text-muted)">@(_value?.ToString() ?? "(none)")</span>
    </Example>
</ShowcaseSection>

<ShowcaseSection Title="States">
    <Example Column="true">
        <div style="width: 240px;"><LucentSelect Placeholder="Disabled select" Options="_options" Disabled="true" /></div>
    </Example>
    <Example Column="true">
        <div style="width: 240px;"><LucentSelect Label="With error" Options="_options" Error="A workspace is required." /></div>
    </Example>
    <Example Label="sm" Column="true">
        <div style="width: 240px;"><LucentSelect Size="ControlSize.Sm" Placeholder="Small" Options="_options" /></div>
    </Example>
</ShowcaseSection>

@code {
    private object? _value;

    private readonly List<SelectOption> _options =
    [
        new("Personal", "personal"),
        new("Acme Co.", "acme"),
        new("Globex", "globex"),
        new("Initech", "initech"),
    ];
}
