@page "/c/checkbox"

<PageTitle>Checkbox — Lucent</PageTitle>

<h1>Checkbox</h1>
<p class="sc-page__lead"><code>LucentCheckbox</code> — native checkbox under the hood (click works, no JS).</p>

<ShowcaseSection Title="States">
    <Example Label="unchecked"><LucentCheckbox Label="Remember me" /></Example>
    <Example Label="checked"><LucentCheckbox Label="Remember me" Checked="true" /></Example>
    <Example Label="indeterminate"><LucentCheckbox Label="Select all" Indeterminate="true" /></Example>
    <Example Label="disabled"><LucentCheckbox Label="Remember me" Disabled="true" /></Example>
    <Example Label="disabled checked"><LucentCheckbox Label="Remember me" Checked="true" Disabled="true" /></Example>
</ShowcaseSection>

<ShowcaseSection Title="Sizes">
    <Example Label="xs"><LucentCheckbox Size="ControlSize.Xs" Label="Extra small" Checked="true" /></Example>
    <Example Label="sm"><LucentCheckbox Size="ControlSize.Sm" Label="Small" Checked="true" /></Example>
    <Example Label="md"><LucentCheckbox Size="ControlSize.Md" Label="Medium" Checked="true" /></Example>
    <Example Label="lg"><LucentCheckbox Size="ControlSize.Lg" Label="Large" Checked="true" /></Example>
</ShowcaseSection>
