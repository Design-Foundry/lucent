@page "/c/tabs"
@rendermode InteractiveServer

<PageTitle>Tabs — Lucent</PageTitle>

<h1>Tabs</h1>
<p class="sc-page__lead"><code>LucentTabList</code> + <code>LucentTab</code> — click or arrow-key to switch. This page runs Server-interactive.</p>

<ShowcaseSection Title="Tab list">
    <Example Column="true">
        <LucentTabList @bind-ActiveTab="_active">
            <LucentTab Value="overview" Label="Overview" Icon="dashboard" />
            <LucentTab Value="activity" Label="Activity" Icon="history" />
            <LucentTab Value="settings" Label="Settings" Icon="settings" />
            <LucentTab Value="archived" Label="Archived" Disabled="true" />
        </LucentTabList>
    </Example>
    <Example Label="active value" Column="true">
        <span style="color: var(--color--semantic--text-muted)">@_active</span>
    </Example>
</ShowcaseSection>

<ShowcaseSection Title="Scales">
    <Example Label="lg" Column="true">
        <LucentTabList Scale="TabScale.Lg" ActiveTab="a"><LucentTab Value="a" Label="Large" /><LucentTab Value="b" Label="Tab" /></LucentTabList>
    </Example>
    <Example Label="md" Column="true">
        <LucentTabList Scale="TabScale.Md" ActiveTab="a"><LucentTab Value="a" Label="Medium" /><LucentTab Value="b" Label="Tab" /></LucentTabList>
    </Example>
    <Example Label="sm" Column="true">
        <LucentTabList Scale="TabScale.Sm" ActiveTab="a"><LucentTab Value="a" Label="Small" /><LucentTab Value="b" Label="Tab" /></LucentTabList>
    </Example>
    <Example Label="xs" Column="true">
        <LucentTabList Scale="TabScale.Xs" ActiveTab="a"><LucentTab Value="a" Label="XS" /><LucentTab Value="b" Label="Tab" /></LucentTabList>
    </Example>
</ShowcaseSection>

@code {
    private string _active = "overview";
}
