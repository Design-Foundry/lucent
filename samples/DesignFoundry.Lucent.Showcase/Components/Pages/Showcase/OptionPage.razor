@page "/c/option"

<PageTitle>Option — Lucent</PageTitle>

<h1>Option</h1>
<p class="sc-page__lead"><code>LucentOption</code> — a listbox row (the building block of LucentSelect's dropdown).</p>

<ShowcaseSection Title="States">
    <Example Column="true">
        <div style="width: 220px; background: var(--color--semantic--surface-default); border: var(--border-subtle); border-radius: var(--radius-sm); padding: 4px 2px;" role="listbox">
            <LucentOption Label="Default option" />
            <LucentOption Label="Active (keyboard)" Active="true" />
            <LucentOption Label="Selected" Selected="true" />
            <LucentOption Label="Disabled" Disabled="true" />
        </div>
    </Example>
</ShowcaseSection>
