@page "/c/button"

<PageTitle>Button — Lucent</PageTitle>

<h1>Button</h1>
<p class="sc-page__lead"><code>LucentButton</code> — variant × size, plus disabled.</p>

<ShowcaseSection Title="Variants">
    <Example Label="primary"><LucentButton Variant="LucentButtonVariant.Primary">Primary</LucentButton></Example>
    <Example Label="secondary"><LucentButton Variant="LucentButtonVariant.Secondary">Secondary</LucentButton></Example>
    <Example Label="ghost"><LucentButton Variant="LucentButtonVariant.Ghost">Ghost</LucentButton></Example>
    <Example Label="danger"><LucentButton Variant="LucentButtonVariant.Danger">Danger</LucentButton></Example>
    <Example Label="text"><LucentButton Variant="LucentButtonVariant.Text">Text</LucentButton></Example>
    <Example Label="on-glass"><LucentButton Variant="LucentButtonVariant.OnGlass">On glass</LucentButton></Example>
</ShowcaseSection>

<ShowcaseSection Title="Sizes">
    <Example Label="xs"><LucentButton Size="ControlSize.Xs">Extra small</LucentButton></Example>
    <Example Label="sm"><LucentButton Size="ControlSize.Sm">Small</LucentButton></Example>
    <Example Label="md"><LucentButton Size="ControlSize.Md">Medium</LucentButton></Example>
    <Example Label="lg"><LucentButton Size="ControlSize.Lg">Large</LucentButton></Example>
</ShowcaseSection>

<ShowcaseSection Title="Disabled">
    <Example Label="primary"><LucentButton Disabled="true">Disabled</LucentButton></Example>
    <Example Label="ghost"><LucentButton Variant="LucentButtonVariant.Ghost" Disabled="true">Disabled</LucentButton></Example>
</ShowcaseSection>
