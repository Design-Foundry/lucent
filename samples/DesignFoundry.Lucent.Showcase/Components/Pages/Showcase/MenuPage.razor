@page "/c/menu"
@rendermode InteractiveServer

<PageTitle>Menu — Lucent</PageTitle>

<h1>Menu</h1>
<p class="sc-page__lead"><code>LucentMenu</code> + <code>LucentMenuItem</code> + <code>LucentMenuDivider</code> — click the trigger to open. This page runs Server-interactive.</p>

<ShowcaseSection Title="Dropdown menu">
    <Example Column="true">
        <LucentMenu>
            <Trigger>
                <LucentButton Variant="LucentButtonVariant.Ghost">Options</LucentButton>
            </Trigger>
            <ChildContent>
                <LucentMenuItem Icon="edit" Label="Rename" @onclick="@(() => _last = "Rename")" />
                <LucentMenuItem Icon="content_copy" Label="Duplicate" @onclick="@(() => _last = "Duplicate")" />
                <LucentMenuItem Icon="archive" Label="Archive" @onclick="@(() => _last = "Archive")" />
                <LucentMenuDivider />
                <LucentMenuItem Icon="delete" Label="Delete" Variant="MenuItemVariant.Danger" @onclick="@(() => _last = "Delete")" />
            </ChildContent>
        </LucentMenu>
    </Example>
    <Example Label="last action" Column="true">
        <span style="color: var(--color--semantic--text-muted)">@(_last ?? "(none)")</span>
    </Example>
</ShowcaseSection>

@code {
    private string? _last;
}
