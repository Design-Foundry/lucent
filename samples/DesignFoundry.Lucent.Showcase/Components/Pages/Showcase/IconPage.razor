@page "/c/icon"

<PageTitle>Icon — Lucent</PageTitle>

<h1>Icon</h1>
<p class="sc-page__lead"><code>LucentIcon</code> — a Material Icons glyph by ligature name, sized xs–xl.</p>

<ShowcaseSection Title="Sizes" Note="font-size/box from --dimension--primitive--icon-*">
    <Example Label="xs"><LucentIcon Name="settings" Size="IconSize.Xs" /></Example>
    <Example Label="sm"><LucentIcon Name="settings" Size="IconSize.Sm" /></Example>
    <Example Label="md"><LucentIcon Name="settings" Size="IconSize.Md" /></Example>
    <Example Label="lg"><LucentIcon Name="settings" Size="IconSize.Lg" /></Example>
    <Example Label="xl"><LucentIcon Name="settings" Size="IconSize.Xl" /></Example>
</ShowcaseSection>

<ShowcaseSection Title="Glyphs">
    <Example Label="search"><LucentIcon Name="search" Size="IconSize.Lg" /></Example>
    <Example Label="close"><LucentIcon Name="close" Size="IconSize.Lg" /></Example>
    <Example Label="more_vert"><LucentIcon Name="more_vert" Size="IconSize.Lg" /></Example>
    <Example Label="mail"><LucentIcon Name="mail" Size="IconSize.Lg" /></Example>
    <Example Label="check_circle"><LucentIcon Name="check_circle" Size="IconSize.Lg" /></Example>
    <Example Label="warning"><LucentIcon Name="warning" Size="IconSize.Lg" /></Example>
</ShowcaseSection>

<ShowcaseSection Title="Color follows currentColor">
    <Example Label="accent">
        <span style="color: var(--color--semantic--accent-default)"><LucentIcon Name="palette" Size="IconSize.Lg" /></span>
    </Example>
    <Example Label="error">
        <span style="color: var(--color--semantic--error)"><LucentIcon Name="error" Size="IconSize.Lg" AriaLabel="Error" /></span>
    </Example>
    <Example Label="muted">
        <span style="color: var(--color--semantic--text-muted)"><LucentIcon Name="info" Size="IconSize.Lg" /></span>
    </Example>
</ShowcaseSection>
