@page "/c/icon-button"

<PageTitle>Icon button — Lucent</PageTitle>

<h1>Icon button</h1>
<p class="sc-page__lead"><code>LucentIconButton</code> — square, icon-only; shares the button's variants.</p>

<ShowcaseSection Title="Variants">
    <Example Label="primary"><LucentIconButton Icon="add" Variant="LucentButtonVariant.Primary" AriaLabel="Add" /></Example>
    <Example Label="secondary"><LucentIconButton Icon="edit" Variant="LucentButtonVariant.Secondary" AriaLabel="Edit" /></Example>
    <Example Label="ghost"><LucentIconButton Icon="more_vert" Variant="LucentButtonVariant.Ghost" AriaLabel="More" /></Example>
    <Example Label="on-glass"><LucentIconButton Icon="star" Variant="LucentButtonVariant.OnGlass" AriaLabel="Favorite" /></Example>
    <Example Label="danger"><LucentIconButton Icon="delete" Variant="LucentButtonVariant.Danger" AriaLabel="Delete" /></Example>
    <Example Label="text"><LucentIconButton Icon="search" Variant="LucentButtonVariant.Text" AriaLabel="Search" /></Example>
</ShowcaseSection>

<ShowcaseSection Title="Sizes">
    <Example Label="sm"><LucentIconButton Icon="settings" Size="IconButtonSize.Sm" AriaLabel="Settings" /></Example>
    <Example Label="md"><LucentIconButton Icon="settings" Size="IconButtonSize.Md" AriaLabel="Settings" /></Example>
    <Example Label="lg"><LucentIconButton Icon="settings" Size="IconButtonSize.Lg" AriaLabel="Settings" /></Example>
</ShowcaseSection>

<ShowcaseSection Title="Disabled">
    <Example Label="primary"><LucentIconButton Icon="add" Disabled="true" AriaLabel="Add" /></Example>
    <Example Label="ghost"><LucentIconButton Icon="more_vert" Variant="LucentButtonVariant.Ghost" Disabled="true" AriaLabel="More" /></Example>
</ShowcaseSection>
