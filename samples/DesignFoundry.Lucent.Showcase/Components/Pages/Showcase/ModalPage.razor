@page "/c/modal"
@rendermode InteractiveServer

<PageTitle>Modal — Lucent</PageTitle>

<h1>Modal</h1>
<p class="sc-page__lead"><code>LucentModal</code> — a dialog over a scrim. Toggle with @@bind-Open. This page runs Server-interactive.</p>

<ShowcaseSection Title="Triggers">
    <Example Label="informative">
        <LucentButton @onclick="@(() => _info = true)">Open info</LucentButton>
    </Example>
    <Example Label="destructive">
        <LucentButton Variant="LucentButtonVariant.Danger" @onclick="@(() => _confirm = true)">Delete project…</LucentButton>
    </Example>
    <Example Label="last action" Column="true">
        <span style="color: var(--color--semantic--text-muted)">@(_last ?? "(none)")</span>
    </Example>
</ShowcaseSection>

<LucentModal @bind-Open="_info" Title="About Lucent" Subtitle="Design Foundry's design system">
    <p style="margin: 0; color: var(--color--semantic--text-default)">
        This is an informative dialog — no footer, dismiss with the close button, the scrim, or Escape.
    </p>
</LucentModal>

<LucentModal @bind-Open="_confirm"
             Title="Delete project?"
             Subtitle="This cannot be undone."
             Variant="ModalVariant.Destructive"
             ConfirmLabel="Delete"
             OnConfirmed="@(() => _last = "Confirmed delete")"
             OnCancelled="@(() => _last = "Cancelled")">
    <p style="margin: 0; color: var(--color--semantic--text-default)">
        The project and all its versions will be permanently removed.
    </p>
</LucentModal>

@code {
    private bool _info;
    private bool _confirm;
    private string? _last;
}
