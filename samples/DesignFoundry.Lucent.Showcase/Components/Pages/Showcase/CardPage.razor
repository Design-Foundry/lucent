@page "/c/card"

<PageTitle>Card — Lucent</PageTitle>

<h1>Card</h1>
<p class="sc-page__lead"><code>LucentCard</code> — a glass surface that groups related content.</p>

<ShowcaseSection Title="Card">
    <Example Column="true">
        <div style="width: 360px;">
            <LucentCard>
                <h3 style="margin: 0; color: var(--color--semantic--text-strong)">Project settings</h3>
                <p style="margin: 0; color: var(--color--semantic--text-muted)">Group related content on a single elevated surface.</p>
                <div style="display: flex; gap: 8px;">
                    <LucentButton Variant="LucentButtonVariant.Primary">Save</LucentButton>
                    <LucentButton Variant="LucentButtonVariant.Ghost">Cancel</LucentButton>
                </div>
            </LucentCard>
        </div>
    </Example>
</ShowcaseSection>
