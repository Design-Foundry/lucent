@page "/c/tooltip"

<PageTitle>Tooltip — Lucent</PageTitle>

<h1>Tooltip</h1>
<p class="sc-page__lead">
    <code>LucentTooltip</code> — wraps a trigger; bubble shows on hover/focus (pure CSS).
    Hover a button below to see it.
</p>

<ShowcaseSection Title="Positions" Note="Hover each trigger.">
    <Example Label="top">
        <LucentTooltip Text="Tooltip on top" Position="TooltipPosition.Top">
            <LucentButton Variant="LucentButtonVariant.Ghost">Top</LucentButton>
        </LucentTooltip>
    </Example>
    <Example Label="bottom">
        <LucentTooltip Text="Tooltip on bottom" Position="TooltipPosition.Bottom">
            <LucentButton Variant="LucentButtonVariant.Ghost">Bottom</LucentButton>
        </LucentTooltip>
    </Example>
    <Example Label="left">
        <LucentTooltip Text="Tooltip on left" Position="TooltipPosition.Left">
            <LucentButton Variant="LucentButtonVariant.Ghost">Left</LucentButton>
        </LucentTooltip>
    </Example>
    <Example Label="right">
        <LucentTooltip Text="Tooltip on right" Position="TooltipPosition.Right">
            <LucentButton Variant="LucentButtonVariant.Ghost">Right</LucentButton>
        </LucentTooltip>
    </Example>
</ShowcaseSection>
