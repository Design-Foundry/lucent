@page "/c/activity-bar"

<PageTitle>Activity bar — Lucent</PageTitle>

<h1>Activity bar</h1>
<p class="sc-page__lead"><code>LucentActivityBar</code> — a horizontal glass container for a dense control cluster (a toolbar).</p>

<ShowcaseSection Title="Toolbar">
    <Example>
        <LucentActivityBar>
            <LucentIconButton Icon="undo" Variant="LucentButtonVariant.Text" Size="IconButtonSize.Sm" AriaLabel="Undo" />
            <LucentIconButton Icon="redo" Variant="LucentButtonVariant.Text" Size="IconButtonSize.Sm" AriaLabel="Redo" />
            <LucentIconButton Icon="format_bold" Variant="LucentButtonVariant.Text" Size="IconButtonSize.Sm" AriaLabel="Bold" />
            <LucentIconButton Icon="format_italic" Variant="LucentButtonVariant.Text" Size="IconButtonSize.Sm" AriaLabel="Italic" />
            <LucentChip Type="ChipType.Tag" Size="ControlSize.Sm" Label="100%" />
        </LucentActivityBar>
    </Example>
</ShowcaseSection>
